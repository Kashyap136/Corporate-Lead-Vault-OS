MONGO_URI=<production MongoDB URI>
JWT_SECRET=<strong random secret>
FRONTEND_URL=<https://your-frontend-domain> (used for CORS and password-reset links)
WHATSAPP_TOKEN=<company credential>
FAST2SMS_KEY=<company credential>

# SMTP configuration for password-reset emails (backend only, never the frontend).
# Standard SMTP providers are supported; do not hardcode a specific provider.
EMAIL_SERVICE_HOST=<SMTP host, e.g. smtp.example.com>
EMAIL_SERVICE_USER=<SMTP username / authenticated sender>
EMAIL_SERVICE_PASSWORD=<SMTP password or app password>
# Optional overrides (defaults are port 587 + STARTTLS, secure=false):
EMAIL_SERVICE_PORT=587
EMAIL_SERVICE_SECURE=false
# Optional display sender (defaults to EMAIL_SERVICE_USER):
EMAIL_FROM=<Corporate Lead Vault OS <sender@example.com>>

# Gmail example (NOT for production unless intended):
#   EMAIL_SERVICE_HOST=smtp.gmail.com
#   EMAIL_SERVICE_USER=your-address@gmail.com
#   EMAIL_SERVICE_PASSWORD=<16-char Google App Password, never your Gmail password>
#   EMAIL_SERVICE_PORT=465
#   EMAIL_SERVICE_SECURE=true
# Never commit the app password. Verify locally with: npm run verify:smtp